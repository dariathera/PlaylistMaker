<?xml version="1.0" encoding="utf-8"?>
<resources>

    <declare-styleable name="PlaybackButtonView">

        <attr name="state"
            format="enum">
            <enum name="play"
                value="0" />
            <enum name="pause"
                value="1" />
        </attr>

        <attr name="playImageResId"
            format="reference" />

        <attr name="pauseImageResId"
            format="reference" />

    </declare-styleable>

</resources>