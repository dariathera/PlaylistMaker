<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="61dp"
    android:gravity="center"
    android:paddingStart="7dp"
    android:paddingEnd="0dp"
    android:orientation="horizontal">

    <!-- Цвет плейсходера в обеих темах одинаков;
         он задан в ресурсном файле ic_artwork_placeholder_45 -->
    <ImageView
        android:id="@+id/playlist_cover"
        android:layout_width="45dp"
        android:layout_height="45dp"
        android:layout_gravity="center"
        android:layout_margin="8dp"
        tools:srcCompat="@drawable/ic_artwork_placeholder_45" />

    <LinearLayout
        android:id="@+id/line"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:gravity="start"
        android:layout_weight="1"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="14dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/name"
            android:layout_width="match_parent"
            android:layout_height="19dp"
            android:textColor="?attr/colorOnPrimary"
            android:fontFamily="@font/ys_display_regular"
            android:textSize="@dimen/plainText"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="No Reply"/>

        <TextView
            style="@style/SearchTrackListItemSmallText"
            android:id="@+id/size"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:layout_weight="1"
            tools:text="The Beatles" />

    </LinearLayout>

</LinearLayout>